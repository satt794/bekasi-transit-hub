# ==============================================================================
# Bekasi Transit API — Konfigurasi Environment (Opsional)
# Nilai default di bawah sudah langsung jalan tanpa perlu file ini.
# ==============================================================================

# Urutan provider scraping yang dicoba (dipisah koma):
# - kci: API resmi KAI Commuter (memerlukan KCI_API_TOKEN)
# - comuline: Mirror publik jadwal KRL (api.comuline.com)
# - snapshot: Snapshot lokal di disk jika sumber online tidak terjangkau
PROVIDERS=kci,comuline,snapshot

# Token Bearer KAI Commuter (opsional; jika kosong, provider kci dilewati otomatis)
# KCI_API_TOKEN=

# URL Base API Scraper
# KCI_API_BASE=https://api-partner.krl.co.id/krl-webs/v1
# COMULINE_API_BASE=https://api.comuline.com/v1

# Cache TTL (dalam detik)
# SCHEDULE_TTL=300
# STATION_TTL=21600
# ROUTE_TTL=1800
# HTTP_TIMEOUT=12

# CORS Origins yang diizinkan (dipisah koma)
CORS_ORIGINS=http://localhost:3000
